# Backend environment example for Trustbound Airbag
#
# Copy this file to `.env` in development and fill values as needed.
#
# API_KEY: Helius API key (required for live on-chain data). Leave empty for mock/fallback behavior.
API_KEY=

# CORS_ALLOWED_ORIGINS: comma-separated list of allowed origins for CORS.
# For production set it to your Vercel frontend origin:
# e.g. CORS_ALLOWED_ORIGINS=https://hackaton-dev3-pack-solana.vercel.app
CORS_ALLOWED_ORIGINS=https://hackaton-dev3-pack-solana.vercel.app

# RUGCHECK_URL: optional override for rugcheck API endpoint.
RUGCHECK_URL=

# LOG_LEVEL: info / debug / warning
LOG_LEVEL=info

